# Store uploads shared by every app. release.sh passes the artifact path and package name.
# Credentials are read from fastlane/.env in this repo (see .env.example).

default_platform(:ios)

# A setting from the environment, with a plain message when it is missing or blank.
def setting!(name)
  value = ENV[name].to_s.strip
  UI.user_error!("#{name} is not set (credentials and options live in fastlane/.env, see .env.example)") if value.empty?
  value
end

# A setting that names a file, checked before fastlane tries to use it. `ext` is the extension it must have.
def file_setting!(name, ext = nil)
  path = File.expand_path(setting!(name))
  UI.user_error!("#{name} should be a path ending in .#{ext}") if ext && File.extname(path) != ".#{ext}"
  UI.user_error!("#{name} points to a missing file: #{path}") unless File.file?(path)
  path
end

# A setting with a known shape, so a typo fails here and not as an obscure error from Apple.
def format_setting!(name, pattern, hint)
  value = setting!(name)
  UI.user_error!("#{name} #{hint}") unless value.match?(pattern)
  value
end

lane :ios_upload do
  ipa = file_setting!("IPA_PATH", "ipa")

  api_key = app_store_connect_api_key(
    key_id: format_setting!("ASC_KEY_ID", /\A[A-Z0-9]{10}\z/, "should be 10 capital letters or digits"),
    issuer_id: format_setting!("ASC_ISSUER_ID", /\A\h{8}(-\h{4}){3}-\h{12}\z/, "should be a UUID like 69a6de70-03db-47e3-e053-5b8c7c11a4d1"),
    key_filepath: file_setting!("ASC_KEY_PATH", "p8"),
  )

  upload_to_testflight(
    api_key: api_key,
    ipa: ipa,
    skip_waiting_for_build_processing: true,
  )
end

lane :android_upload do
  aab = file_setting!("AAB_PATH", "aab")

  upload_to_play_store(
    package_name: setting!("ANDROID_PACKAGE"),
    json_key: file_setting!("PLAY_JSON_KEY_PATH", "json"),
    track: ENV["PLAY_TRACK"].to_s.strip.then { |t| t.empty? ? "internal" : t },
    # An app that was never published only accepts "draft" here (set PLAY_RELEASE_STATUS=draft once).
    release_status: ENV["PLAY_RELEASE_STATUS"].to_s.strip.then { |s| s.empty? ? "completed" : s },
    aab: aab,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true,
  )
end
