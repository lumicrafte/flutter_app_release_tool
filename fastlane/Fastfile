# Store uploads shared by every app. release.sh passes the artifact path and package name.
# Credentials are read from fastlane/.env in this repo (see .env.example).

default_platform(:ios)

lane :ios_upload do
  ipa = ENV["IPA_PATH"] || UI.user_error!("IPA_PATH is not set")

  api_key = app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
  )

  upload_to_testflight(
    api_key: api_key,
    ipa: ipa,
    skip_waiting_for_build_processing: true,
  )
end

lane :android_upload do
  aab = ENV["AAB_PATH"] || UI.user_error!("AAB_PATH is not set")

  upload_to_play_store(
    package_name: ENV["ANDROID_PACKAGE"] || UI.user_error!("ANDROID_PACKAGE is not set"),
    json_key: File.expand_path(ENV.fetch("PLAY_JSON_KEY_PATH")),
    track: ENV.fetch("PLAY_TRACK", "internal"),
    aab: aab,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true,
  )
end
