# Copy to fastlane/.env (gitignored) and fill in.

# App Store Connect API key: Users and Access > Integrations > App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Play Console service account JSON
PLAY_JSON_KEY_PATH=~/.play/service-account.json
# internal | alpha | beta | production
PLAY_TRACK=internal
# Only for an app that was never published on Play: draft (otherwise leave unset)
#PLAY_RELEASE_STATUS=draft
